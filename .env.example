# ===== AI 服务（DeepSeek）=====
# 必填：DeepSeek 的 API Key
AI_API_KEY=sk-your-deepseek-key
# 可选：DeepSeek 接口地址（默认即下方值）
AI_API_URL=https://api.deepseek.com/v1/chat/completions
# 可选：模型名（默认 deepseek-chat）
AI_MODEL=deepseek-chat

# ===== 数据库连接 =====
# 方式一：直接用 DATABASE_URL（Neon / Supabase / Vercel Postgres 等）
# Vercel Postgres 创建后会自动注入 POSTGRES_URL，无需手动设置
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# 方式二：使用 Vercel Postgres 自带的 POSTGRES_URL（代码已自动识别，二选一即可）
# POSTGRES_URL=postgresql://default:xxx@aws.connect.psdb.cloud/db?sslmode=require

# 说明：
# - 本地开发可不填数据库，自动回退到本地 JSON 文件存储（.data/）
# - 部署到 Vercel 必须配置数据库连接（推荐 Vercel Postgres 或 Neon），否则写入会报错
# - 建表会在首次访问 API 时自动完成（ensureDB），无需手动执行 scripts/init-db.mjs
